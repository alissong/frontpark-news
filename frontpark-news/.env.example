# Copie este arquivo para ".env" e preencha com os dados da sua planilha.
#
# 1. Crie uma planilha no Google Sheets com as colunas: section | key | value | extra | level
# 2. Em "Compartilhar", deixe como "Qualquer pessoa com o link pode ver".
# 3. Copie o ID da planilha: na URL https://docs.google.com/spreadsheets/d/<ID>/edit
#
# Sem estas variáveis, a página exibe um conteúdo de exemplo.

VITE_SHEET_ID=
# Nome da aba/guia com o conteúdo principal (opcional, padrão: Conteudo)
VITE_SHEET_NAME=Conteudo
# Nome da aba/guia com a galeria de fotos e vídeos (opcional, padrão: Galeria)
VITE_GALLERY_SHEET=Galeria
